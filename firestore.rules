rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'provider', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'provider', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.provider is string
        && data.provider.size() <= 32
        && data.provider in ['google.com', 'password']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudyTemplate(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'instructions', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'instructions', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 100
        && data.instructions is string
        && data.instructions.size() >= 1
        && data.instructions.size() <= 4000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCodeOrchestration(orch) {
      return orch is map
        && orch.keys().hasAll(['mode', 'roles', 'autoRun'])
        && orch.keys().hasOnly(['mode', 'roles', 'autoRun'])
        && orch.mode is string
        && orch.mode.size() <= 16
        && orch.mode in ['custom', 'single']
        && orch.autoRun is bool
        && orch.roles is map
        && orch.roles.keys().hasAll(['architect', 'coder', 'reviewer'])
        && orch.roles.keys().hasOnly(['architect', 'coder', 'reviewer'])
        && (orch.roles.architect == null || (orch.roles.architect is string && orch.roles.architect.size() <= 160))
        && (orch.roles.coder == null || (orch.roles.coder is string && orch.roles.coder.size() <= 160))
        && (orch.roles.reviewer == null || (orch.roles.reviewer is string && orch.roles.reviewer.size() <= 160));
    }

    function isValidWorkspaceSettings(settings) {
      return settings is map
        && settings.keys().hasOnly([
          'theme',
          'accentTheme',
          'chatLayout',
          'oledDark',
          'a2uiEnabled',
          'a2uiMode',
          'confirmBeforeWrite',
          'maxAgentSteps',
          'toolOutputBudgetChars',
          'alwaysAllowedTools',
          'alwaysAllowedRules',
          'toolPolicies',
          'biometricLockEnabled',
          'hapticsEnabled',
          'onboardingCompleted',
          'localModelToolsEnabled',
          'manualModelOverrides',
          'codeOrchestration'
        ])
        && (!('theme' in settings) || (settings.theme is string && settings.theme.size() <= 16 && settings.theme in ['system', 'light', 'dark']))
        && (!('accentTheme' in settings) || (settings.accentTheme is string && settings.accentTheme.size() <= 32 && settings.accentTheme in ['pixel_blue', 'sage', 'clay', 'lavender', 'monochrome']))
        && (!('chatLayout' in settings) || (settings.chatLayout is string && settings.chatLayout.size() <= 16 && settings.chatLayout in ['standard', 'focus']))
        && (!('oledDark' in settings) || settings.oledDark is bool)
        && (!('a2uiEnabled' in settings) || settings.a2uiEnabled is bool)
        && (!('a2uiMode' in settings) || (settings.a2uiMode is string && settings.a2uiMode.size() <= 16 && settings.a2uiMode in ['off', 'smart', 'always']))
        && (!('confirmBeforeWrite' in settings) || settings.confirmBeforeWrite is bool)
        && (!('maxAgentSteps' in settings) || (settings.maxAgentSteps is number && settings.maxAgentSteps >= 1 && settings.maxAgentSteps <= 25))
        && (!('toolOutputBudgetChars' in settings) || (settings.toolOutputBudgetChars is number && settings.toolOutputBudgetChars >= 1000 && settings.toolOutputBudgetChars <= 32000))
        && (!('alwaysAllowedTools' in settings) || (settings.alwaysAllowedTools is list && settings.alwaysAllowedTools.size() <= 100 && (settings.alwaysAllowedTools.size() == 0 || settings.alwaysAllowedTools[0] is string)))
        && (!('alwaysAllowedRules' in settings) || (settings.alwaysAllowedRules is list && settings.alwaysAllowedRules.size() <= 100 && (settings.alwaysAllowedRules.size() == 0 || settings.alwaysAllowedRules[0] is map)))
        && (!('toolPolicies' in settings) || (settings.toolPolicies is list && settings.toolPolicies.size() <= 100 && (settings.toolPolicies.size() == 0 || settings.toolPolicies[0] is map)))
        && (!('biometricLockEnabled' in settings) || settings.biometricLockEnabled is bool)
        && (!('hapticsEnabled' in settings) || settings.hapticsEnabled is bool)
        && (!('onboardingCompleted' in settings) || settings.onboardingCompleted is bool)
        && (!('localModelToolsEnabled' in settings) || settings.localModelToolsEnabled is bool)
        && (!('manualModelOverrides' in settings) || (settings.manualModelOverrides is list && settings.manualModelOverrides.size() <= 100 && (settings.manualModelOverrides.size() == 0 || settings.manualModelOverrides[0] is string)))
        && (!('codeOrchestration' in settings) || isValidCodeOrchestration(settings.codeOrchestration));
    }

    function isValidWorkspaceState(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'settings',
          'agents',
          'servers',
          'dynamicModels',
          'dismissedDefaultServerIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'settings',
          'agents',
          'servers',
          'dynamicModels',
          'dismissedDefaultServerIds',
          'savedPrompts',
          'projects',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidWorkspaceSettings(data.settings)
        && data.agents is list
        && data.agents.size() <= 50
        && (data.agents.size() == 0 || data.agents[0] is map)
        && data.servers is list
        && data.servers.size() <= 50
        && (data.servers.size() == 0 || data.servers[0] is map)
        && data.dynamicModels is list
        && data.dynamicModels.size() <= 100
        && (data.dynamicModels.size() == 0 || data.dynamicModels[0] is map)
        && data.dismissedDefaultServerIds is list
        && data.dismissedDefaultServerIds.size() <= 50
        && (data.dismissedDefaultServerIds.size() == 0 || data.dismissedDefaultServerIds[0] is string)
        && (!('savedPrompts' in data) || (data.savedPrompts is list && data.savedPrompts.size() <= 100 && (data.savedPrompts.size() == 0 || data.savedPrompts[0] is map)))
        && (!('projects' in data) || (data.projects is list && data.projects.size() <= 50 && (data.projects.size() == 0 || data.projects[0] is map)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidForkedFrom(forkedFrom) {
      return forkedFrom == null || (
        forkedFrom is map
        && forkedFrom.keys().hasAll(['conversationId'])
        && forkedFrom.keys().hasOnly(['conversationId', 'messageId'])
        && forkedFrom.conversationId is string
        && forkedFrom.conversationId.size() >= 1
        && forkedFrom.conversationId.size() <= 128
        && (!('messageId' in forkedFrom) || (forkedFrom.messageId is string && forkedFrom.messageId.size() <= 128))
      );
    }

    function isValidCodingSession(session) {
      return session == null || (
        session is map
        && session.keys().hasAll(['activePlan', 'files', 'diffs', 'checkpoints', 'toolTrace', 'contextStats'])
        && session.keys().hasOnly(['activePlan', 'files', 'diffs', 'checkpoints', 'toolTrace', 'contextStats'])
        && (session.activePlan == null || session.activePlan is map)
        && session.files is map
        && session.diffs is map
        && session.checkpoints is list
        && session.checkpoints.size() <= 10
        && (session.checkpoints.size() == 0 || session.checkpoints[0] is map)
        && session.toolTrace is list
        && session.toolTrace.size() <= 100
        && (session.toolTrace.size() == 0 || session.toolTrace[0] is map)
        && session.contextStats is map
      );
    }

    function isValidConversationDoc(data, userId, convId) {
      return data.keys().hasAll([
          'ownerId',
          'id',
          'title',
          'agentId',
          'modelId',
          'effort',
          'chatMode',
          'knowledgeSource',
          'studyInstructions',
          'messages',
          'clientCreatedAt',
          'clientUpdatedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'id',
          'title',
          'agentId',
          'modelId',
          'effort',
          'chatMode',
          'knowledgeSource',
          'studyInstructions',
          'projectId',
          'forkedFrom',
          'codingSession',
          'messages',
          'clientCreatedAt',
          'clientUpdatedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.id)
        && data.id == convId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.agentId is string
        && data.agentId.size() >= 1
        && data.agentId.size() <= 128
        && data.modelId is string
        && data.modelId.size() >= 1
        && data.modelId.size() <= 160
        && data.effort is string
        && data.effort.size() <= 16
        && data.effort in ['low', 'medium', 'high']
        && data.chatMode is string
        && data.chatMode.size() <= 32
        && data.chatMode in ['general', 'professional', 'study', 'coding']
        && data.knowledgeSource is string
        && data.knowledgeSource.size() <= 32
        && data.knowledgeSource in ['auto', 'uploaded', 'web', 'general']
        && data.studyInstructions is string
        && data.studyInstructions.size() <= 4000
        && (!('projectId' in data) || data.projectId == null || (data.projectId is string && data.projectId.size() <= 128))
        && (!('forkedFrom' in data) || isValidForkedFrom(data.forkedFrom))
        && (!('codingSession' in data) || isValidCodingSession(data.codingSession))
        && data.messages is list
        && data.messages.size() <= 300
        && (data.messages.size() == 0 || data.messages[0] is map)
        && data.clientCreatedAt is number
        && data.clientUpdatedAt is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudyNoteDoc(data, userId, noteId) {
      return data.keys().hasAll([
          'ownerId',
          'id',
          'title',
          'content',
          'clientCreatedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'id',
          'title',
          'content',
          'modelLabel',
          'messageId',
          'clientCreatedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.id)
        && data.id == noteId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 120000
        && (!('modelLabel' in data) || (data.modelLabel is string && data.modelLabel.size() <= 120))
        && (!('messageId' in data) || (data.messageId is string && data.messageId.size() <= 128))
        && data.clientCreatedAt is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/private/{docId} {
      allow get: if isOwner(userId) && isValidId(userId) && docId == 'profile';
      allow create: if isOwner(userId)
        && isVerifiedEmail()
        && isValidId(userId)
        && docId == 'profile'
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isVerifiedEmail()
        && isValidId(userId)
        && docId == 'profile'
        && isValidUserProfile(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'provider', 'updatedAt'])
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isOwner(userId) && isValidId(userId) && docId == 'profile';
    }

    match /users/{userId}/studyTemplates/{templateId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(templateId);
      allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isOwner(userId)
        && isVerifiedEmail()
        && isValidId(userId)
        && isValidId(templateId)
        && isValidStudyTemplate(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isVerifiedEmail()
        && isValidId(userId)
        && isValidId(templateId)
        && isValidStudyTemplate(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'instructions', 'updatedAt'])
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(templateId);
    }

    match /users/{userId}/workspace/{docId} {
      allow get: if isOwner(userId) && isValidId(userId) && docId == 'state';
      allow create: if isOwner(userId)
        && isVerifiedEmail()
        && isValidId(userId)
        && docId == 'state'
        && isValidWorkspaceState(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isVerifiedEmail()
        && isValidId(userId)
        && docId == 'state'
        && isValidWorkspaceState(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'settings',
          'agents',
          'servers',
          'dynamicModels',
          'dismissedDefaultServerIds',
          'savedPrompts',
          'projects',
          'updatedAt'
        ])
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isOwner(userId) && isValidId(userId) && docId == 'state';
    }

    match /users/{userId}/conversations/{convId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(convId);
      allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isOwner(userId)
        && isVerifiedEmail()
        && isValidId(userId)
        && isValidId(convId)
        && isValidConversationDoc(incoming(), userId, convId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isVerifiedEmail()
        && isValidId(userId)
        && isValidId(convId)
        && isValidConversationDoc(incoming(), userId, convId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'agentId',
          'modelId',
          'effort',
          'chatMode',
          'knowledgeSource',
          'studyInstructions',
          'projectId',
          'forkedFrom',
          'codingSession',
          'messages',
          'clientUpdatedAt',
          'updatedAt'
        ])
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().clientCreatedAt == existing().clientCreatedAt
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(convId);
    }

    match /users/{userId}/studyNotes/{noteId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
      allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isOwner(userId)
        && isVerifiedEmail()
        && isValidId(userId)
        && isValidId(noteId)
        && isValidStudyNoteDoc(incoming(), userId, noteId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isVerifiedEmail()
        && isValidId(userId)
        && isValidId(noteId)
        && isValidStudyNoteDoc(incoming(), userId, noteId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'content',
          'modelLabel',
          'messageId',
          'updatedAt'
        ])
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().clientCreatedAt == existing().clientCreatedAt
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
    }
  }
}
