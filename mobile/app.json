{
  "expo": {
    "name": "MCP Hub",
    "slug": "mcp-hub",
    "version": "1.0.0",
    "scheme": "mcphub",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock MCP Hub to access encrypted API keys and MCP credentials."
        }
      ]
    ],
    "android": {
      "package": "app.mcphub.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2563EB"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "mcphub"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            }
          ],
          "category": ["DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "app.mcphub.mobile",
      "supportsTablet": true
    }
  }
}
